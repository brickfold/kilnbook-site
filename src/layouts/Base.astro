---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { title, description, image } = Astro.props;
const ogImage = image && new URL(image, Astro.site);
const canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", Astro.site);
const fullTitle = title === "Kilnbook" ? title : `${title} · Kilnbook`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
		<meta property="og:title" content={fullTitle} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		{
			ogImage && (
				<>
					<meta property="og:image" content={ogImage} />
					<meta property="og:image:width" content="1200" />
					<meta property="og:image:height" content="630" />
					<meta name="twitter:card" content="summary_large_image" />
					<meta name="twitter:image" content={ogImage} />
				</>
			)
		}
		<meta name="theme-color" content="#0f1117" />
		<script is:inline>(function(w,d){var h=null;try{var l=w.localStorage,p=JSON.parse(l.getItem("lv:vp:"+"lv_pub_y0al6h7uxryqzgsrh74f493h")||"[]"),q=(location.pathname||"/").replace(/\/{2,}/g,"/").replace(/(.)\/+$/,"$1");if(!l.getItem("lv:seen:"+"lv_pub_y0al6h7uxryqzgsrh74f493h")||p.indexOf(q)>=0){h=d.createElement("style");h.textContent="html{opacity:0!important}";d.head.appendChild(h)}l.setItem("lv:seen:"+"lv_pub_y0al6h7uxryqzgsrh74f493h","1")}catch(e){}w.__lvReveal=function(){if(h&&h.parentNode)h.parentNode.removeChild(h);h=null};setTimeout(function(){if(h)w.__lvLate=1;w.__lvReveal()},1000);var s=d.createElement("script");s.src="https://lettervisit.com/v.js?k=lv_pub_y0al6h7uxryqzgsrh74f493h";s.async=true;s.setAttribute("data-key","lv_pub_y0al6h7uxryqzgsrh74f493h");s.onerror=w.__lvReveal;d.head.appendChild(s)})(window,document)</script>
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
