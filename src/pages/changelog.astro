---
import Base from "../layouts/Base.astro";
---

<Base
	title="Changelog"
	description="What is new in Kilnbook: updates to kiln firings, classes and class packs, memberships and wheel time, newest first."
>
	<section class="band-dark page-hero">
		<div class="wrap">
			<p class="eyebrow">Changelog</p>
			<h1>What's new in Kilnbook</h1>
			<p class="lede narrow">
				Updates to firings, classes and wheel time, newest first.
			</p>
		</div>
	</section>

	<section class="wrap section narrow">
		<p>
			Updates will be listed here as they ship. In the meantime, the <a href="/blog">Journal</a> has
			notes on running a studio and what we are building at Kilnbook.
		</p>
		<p class="muted">
			Have a request for the team? <a href="/contact">Get in touch</a>.
		</p>
	</section>
</Base>
