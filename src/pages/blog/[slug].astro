---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const author = (await getCollection("authors")).find((a) => a.data.name === post.data.author);
const fmt = new Intl.DateTimeFormat("en-US", { dateStyle: "long" });
---

<Base title={post.data.title} description={post.data.description}>
	<article>
		<header class="band-dark page-hero post-hero">
			<div class="wrap">
				<p class="eyebrow">
					<a href="/blog">Journal</a> · {fmt.format(post.data.pubDate)} · {post.data.author}
				</p>
				<h1>{post.data.title}</h1>
			</div>
		</header>
		<div class="wrap section">
			<div class="prose">
				<Content />
			</div>
			{
				author && (
					<aside class="author-bio prose">
						<p class="eyebrow">About the author</p>
						<h3>{author.data.name}</h3>
						<p class="muted small">{author.data.role}, Kilnbook</p>
						<p>{author.data.bio}</p>
					</aside>
				)
			}
		</div>
	</article>
</Base>
