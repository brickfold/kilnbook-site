---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const fmt = new Intl.DateTimeFormat("en-US", { dateStyle: "long" });
---

<Base
	title="Journal"
	description="Notes on running a pottery studio: firing schedules, pricing classes, membership rules and what we are building at Kilnbook."
>
	<section class="band-dark page-hero">
		<div class="wrap">
			<p class="eyebrow">The journal</p>
			<h1>Notes on running a studio</h1>
			<p class="lede narrow">From the people who build Kilnbook.</p>
		</div>
	</section>

	<section class="wrap section narrow">
		<ul class="post-list">
			{
				posts.map((post) => (
					<li>
						<h2>
							<a href={`/blog/${post.id}`}>{post.data.title}</a>
						</h2>
						<p class="muted small">
							{fmt.format(post.data.pubDate)} · {post.data.author}
						</p>
						<p>{post.data.description}</p>
					</li>
				))
			}
		</ul>
	</section>
</Base>
