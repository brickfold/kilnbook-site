---
const path = Astro.url.pathname;
const links = [
	{ href: "/features/firings", label: "Kiln firings" },
	{ href: "/features/classes", label: "Classes" },
	{ href: "/features/wheel-time", label: "Wheel time" },
	{ href: "/pricing", label: "Pricing" },
	{ href: "/blog", label: "Journal" },
];
---

<header class="site-header">
	<div class="wrap header-inner">
		<a href="/" class="brand" aria-label="Kilnbook home">
			<img src="/images/logo.svg" alt="Kilnbook" width="132" height="32" />
		</a>
		<nav aria-label="Main">
			<ul>
				{
					links.map((l) => (
						<li>
							<a href={l.href} aria-current={path.startsWith(l.href) ? "page" : undefined}>
								{l.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<a href="/contact" class="btn btn-small">Book a demo</a>
	</div>
</header>
